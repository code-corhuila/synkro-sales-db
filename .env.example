# Placeholders only. Copy to .env and fill in; .env is git-ignored.
# Runner: docker compose --env-file .env -f deploy/compose.yml run --rm sales-db-migrate

# Connection to the MongoDB instance (administrator credentials; see
# 05-architecture/deployment.md in synkro-docs). No database name, no query string.
MONGODB_URI=mongodb://<admin-user>:<admin-password>@synkro-mongo:27017

# Database the migrations are applied to (Liquibase history lives here too).
MONGODB_DATABASE=sales

# Query-string options. serverSelectionTimeoutMS makes an unreachable instance
# fail in seconds instead of hanging for the driver default.
MONGODB_OPTIONS=replicaSet=rs0&authSource=admin&serverSelectionTimeoutMS=5000
